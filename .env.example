# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used as the magic-link redirect target. For local dev, leave it out or set
# http://localhost:3000. In production, set it to your live URL, e.g.
# https://sole-supply2.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin email whitelist used by the DB trigger to auto-promote accounts
# (see README for the SQL to apply this). Not read by the app directly.
# Example: ADMIN_EMAILS=nahom@example.com,someone-else@example.com

# Stale-digest cron (M1)
# CRON_SECRET protects /api/cron/stale-digest from public invocation.
# Vercel Cron automatically sends it as "Authorization: Bearer <value>".
# Generate a random string, e.g.: openssl rand -hex 32
CRON_SECRET=your-cron-secret

# Telegram delivery for the stale-shoe digest.
# Create a bot via @BotFather, then start a chat and get the chat ID
# (e.g. via https://api.telegram.org/bot<TOKEN>/getUpdates).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
