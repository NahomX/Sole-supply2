# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used as the magic-link redirect target. For local dev, leave it out or set
# http://localhost:3000. In production, set it to your live URL, e.g.
# https://berebaso.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin email whitelist used by the DB trigger to auto-promote accounts
# (see README for the SQL to apply this). Not read by the app directly.
# Example: ADMIN_EMAILS=nahom@example.com,someone-else@example.com

# ---------------------------------------------------------------------------
# Telegram bots (PR A: infra + customer bot; PR B: work bots + ops bot)
# Each token comes from @BotFather. All are server-only — never expose them
# in client-side code or public env vars.
# ---------------------------------------------------------------------------

# Shared webhook secret — one secret for all bots.
# Generate: openssl rand -hex 32
# Set this in Vercel AND pass it to BotFather via set-webhooks.mjs.
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# Customer bot — public browse bot.
CUSTOMER_BOT_TOKEN=your-customer-bot-token

# Work bots — one per logistics stage.
INCART_BOT_TOKEN=your-incart-bot-token
PURCHASER_BOT_TOKEN=your-purchaser-bot-token
ARRIVED_BOT_TOKEN=your-arrived-bot-token
DELIVERY_BOT_TOKEN=your-delivery-bot-token

# Owner ops bot — full pipeline control.
OPS_BOT_TOKEN=your-ops-bot-token

# ---------------------------------------------------------------------------
# Ops feed — shared team group chat (PR #12 / feat/ops-feed)
# When set, every status change (logistics or sales) and every new in-cart shoe
# triggers a one-line message to this group so all admins see a live activity
# log. Fire-and-forget: if unset, the feature is silently disabled.
# ---------------------------------------------------------------------------

# Chat ID of the shared ops Telegram group (negative integer for groups).
# How to get it:
#   1. Create a private Telegram group (e.g. "Berebaso Ops").
#   2. Add the ops bot (@your_ops_bot) to the group.
#   3. Send any message in the group.
#   4. Open: https://api.telegram.org/bot<OPS_BOT_TOKEN>/getUpdates
#      Look for "chat":{"id":-xxxxxxxxxx} — the negative number is the chat id.
#   5. Paste it here (including the minus sign).
OPS_FEED_CHAT_ID=your-ops-feed-chat-id

# ---------------------------------------------------------------------------
# Stale-digest cron (PR #9 / feat/stale-checker — merge separately)
# The cron will be repointed to use OPS_BOT_TOKEN in PR B.
# For now it uses its own standalone vars below.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Stripe Issuing governance rails (Phase 2 / feat/issuing-rails)
# ALL vars are server-only — no NEXT_PUBLIC_ prefix ever.
# Use TEST mode keys (sk_test_*) until Phase 4 live-mode sign-off.
# ---------------------------------------------------------------------------

# Full Stripe secret key — used by lib/issuing.ts (provision/freeze cards)
# and app/api/webhooks/stripe/route.ts (L2 auth decisions).
# TEST:  sk_test_...
# LIVE:  sk_live_...  (requires Phase 4 approval + Stripe Issuing eligibility)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Webhook signing secret — get from Stripe Dashboard → Webhooks → endpoint details.
# A separate secret is issued per webhook endpoint.
# Register endpoint: https://sole-supply2.vercel.app/api/webhooks/stripe
# Events to subscribe: issuing_authorization.request,
#                      issuing_authorization.updated,
#                      issuing_transaction.created
# CRITICAL: Set "Default action on timeout" to DECLINE in Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ---------------------------------------------------------------------------
# Forwarding address (US shipping destination for all purchases).
# This is the fixed US address where sneakers ship before forwarding to Addis.
# Used by lib/issuing.ts provisionCard() as the cardholder billing address.
# All values are server-only — no NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------
FORWARDING_ADDRESS_LINE1=123 Your Forwarding Address St
FORWARDING_ADDRESS_CITY=Miami
FORWARDING_ADDRESS_STATE=FL
FORWARDING_ADDRESS_POSTAL_CODE=33101
FORWARDING_ADDRESS_COUNTRY=US

# Shared secret protecting /api/cron/stale-digest. Vercel Cron injects it
# automatically as Authorization: Bearer <value> when set in project env.
# Generate: openssl rand -hex 32
CRON_SECRET=your-cron-secret

# Telegram bot token for the stale-digest cron (can reuse OPS_BOT_TOKEN in PR B).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Destination chat/channel ID for the stale-digest.
# Find it: https://api.telegram.org/bot<TOKEN>/getUpdates after sending the bot a message.
TELEGRAM_CHAT_ID=your-chat-id

# ---------------------------------------------------------------------------
# Chapa payments (feat/payments-poc — admin-only test-mode POC)
# All three vars are server-only — NEVER use NEXT_PUBLIC_ prefixes.
# The feature is disabled unless PAYMENTS_POC_ENABLED=true is set.
# ---------------------------------------------------------------------------

# Chapa test secret key. Get it from https://dashboard.chapa.co → Settings →
# API Keys. Use the TEST key (begins with CHASECK_TEST-) for the POC.
# Switch to the live key only after Ethiopian business KYC is approved.
CHAPA_SECRET_KEY=CHASECK_TEST-your-test-key-here

# HMAC-SHA256 webhook signature secret. Set in the Chapa dashboard under
# Settings → Webhooks → Secret. Generate a strong random value:
#   openssl rand -hex 32
# Register the webhook URL:
#   https://sole-supply2.vercel.app/api/webhooks/chapa
CHAPA_WEBHOOK_SECRET=your-chapa-webhook-secret

# Feature flag — set to "true" to enable the Payments (test) section in /admin
# and the /api/admin/test-payment route. Leave unset (or set to anything other
# than "true") to disable the POC entirely without removing code.
PAYMENTS_POC_ENABLED=true

# ---------------------------------------------------------------------------
# Gemini API (AI photo-matching on work bots)
# Server-only — never expose in client-side code or public env vars.
# Used by lib/shoe-matcher.ts for vision-based shoe matching when a
# distributor sends a photo via Telegram. The feature degrades gracefully
# (returns an error message) if this key is unset.
# Get a key from https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# ---------------------------------------------------------------------------
# Anthropic API (ops-bot NL site editing — Tier 2, optional)
# Server-only. Used by lib/site-edit-nl.ts for natural-language site copy
# editing via the ops bot. The feature is disabled unless both this key and
# SITE_EDIT_NL_ENABLED=true are set.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
SITE_EDIT_NL_ENABLED=true
