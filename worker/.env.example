# ============================================================
# Berebaso Agent Worker — environment variables (TEST mode only)
# ============================================================
# Copy to .env and fill in real values.
# This file is safe to commit; .env is gitignored.
#
# LEAST-TRUST PRINCIPLE: the worker never holds the full Stripe
# secret key (sk_*) or the Supabase service-role key. It uses
# only the restricted Stripe key (rk_*) and a scoped Supabase key.
# ============================================================

# ------------------------------------------------------------
# Stripe — RESTRICTED key only (rk_test_* for test mode)
# Dashboard → Developers → API Keys → Create restricted key
#   Permissions: Issuing → Cards → Read only
#   No write, no transfer, no cardholder create/update.
# NEVER set STRIPE_SECRET_KEY (sk_*) here. That lives in Vercel only.
# ------------------------------------------------------------
STRIPE_RESTRICTED_KEY=rk_test_REPLACE_ME

# ------------------------------------------------------------
# Anthropic — Claude model access for the agent loop
# https://console.anthropic.com → API Keys
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ------------------------------------------------------------
# Supabase — scoped key (NOT the service-role key)
# Create a dedicated Postgres role per 0009_worker_scoped_access.sql,
# then generate a JWT for that role in your Supabase project settings,
# OR use the anon key gated by the 0009 RLS policies.
#
# The worker key must have:
#   SELECT on shoe_sizes, shoes, issuing_cards (non-secret cols), purchase_orders, agent_config
#   INSERT/UPDATE on agent_runs
#   INSERT on purchase_orders WHERE status='draft' (enforced by RLS)
# The worker key must NOT have:
#   UPDATE/DELETE on purchase_orders (only the Vercel app may approve/close POs)
#   Any access to spend_ledger, issuing_authorizations, payments (handled by Vercel)
# ------------------------------------------------------------
SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_WORKER_KEY=eyJREPLACE_ME

# ------------------------------------------------------------
# Agent behaviour — safe defaults
# Both guards are also enforced in DB (agent_config table).
# The DB value wins if more restrictive.
# ------------------------------------------------------------
# Set to true only after a human reviews a full TEST dry-run.
AGENT_ENABLED=false
# Maximum POs the worker may draft in one invocation.
MAX_BUYS_PER_RUN=3
# How long (seconds) the worker polls for PO approval before timing out.
PO_APPROVAL_TIMEOUT_SECS=1800

# ------------------------------------------------------------
# Fly.io machine identity (set automatically by Fly at runtime)
# You can override for local debugging.
# ------------------------------------------------------------
# FLY_APP_NAME=berebaso-agent-worker
# FLY_MACHINE_ID=<set by Fly>
